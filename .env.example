# ==============================================================================
# FoodVision AI / Food Calorie App - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual USDA FoodData Central API key:
#   cp .env.example .env   (or copy in File Explorer)
#
# Obtain a free USDA API key at:
#   https://fdc.nal.usda.gov/api-key-signup.html
# ==============================================================================

# USDA FoodData Central API Key (required for live nutrition lookups)
USDA_API_KEY=your_actual_usda_api_key

# Flask Application Secret Key (optional for development, customize for production)
FLASK_SECRET_KEY=super_secret_dev_key
